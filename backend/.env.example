# PhishCheck Backend — Variáveis de Ambiente
# Copie para .env e preencha com suas API keys (todas opcionais)

# VirusTotal v3 — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Google Safe Browsing v4 — https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Timeouts (segundos)
DNS_TIMEOUT=4
WHOIS_TIMEOUT=8
THREAT_INTEL_TIMEOUT=10
URL_FETCH_TIMEOUT=10

# CORS origins (separados por vírgula)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Modo online padrão
ONLINE_BY_DEFAULT=true
